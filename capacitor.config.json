{
  "appId": "com.yojanasahay.app",
  "appName": "Yojana Sahay",
  "webDir": "dist-native",
  "server": {
    "androidScheme": "https",
    "allowNavigation": [
      "yojanasetu-e24bb.firebaseapp.com",
      "*.google.com",
      "*.gstatic.com",
      "*.recaptcha.net"
    ]
  },
  "android": {
    "backgroundColor": "#003580",
    "adjustMarginsForEdgeToEdge": "disable"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 3000,
      "backgroundColor": "#003580",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    },
    "CapacitorUpdater": {
      "autoUpdate": false,
      "statsUrl": "",
      "resetWhenUpdate": true,
      "appReadyTimeout": 20000,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true
    },
    "FirebaseMessaging": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
