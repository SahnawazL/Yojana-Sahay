{
  "appId": "com.yojanasahay.app",
  "appName": "Yojana Sahay",
  "webDir": "dist-native",
  "server": { "androidScheme": "https" },
  "android": { "backgroundColor": "#003580" },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": false,
      "backgroundColor": "#003580",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["google.com"]
    }
  }
}
