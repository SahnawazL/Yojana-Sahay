{
  "id": "com.yojanasahay.app",
  "name": "Yojana Sahay — Government Schemes Finder",
  "short_name": "Yojana Sahay",
  "description": "Free Scheme Finder: find Indian government welfare schemes (sarkari yojana) you are eligible for. Free, Hindi & English, made in India. सरकारी योजनाएं खोजें।",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui",
    "browser"
  ],
  "orientation": "portrait",
  "background_color": "#003580",
  "theme_color": "#FF9933",
  "lang": "en-IN",
  "dir": "ltr",
  "related_applications": [
    {
      "platform": "play",
      "id": "com.yojanasahay.app",
      "url": "https://play.google.com/store/apps/details?id=com.yojanasahay.app"
    }
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "icons": [
    {
      "src": "/icons/logo512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "/icons/logo192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "/icons/maskable512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "maskable"
    },
    {
      "src": "/icons/maskable192.png",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "maskable"
    },
    {
      "src": "/icons/app-monochrome-512.png",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "monochrome"
    },
    {
      "src": "/icons/apple-touch-icon.png",
      "type": "image/png",
      "sizes": "180x180"
    },
    {
      "src": "/icons/favicon-32x32.png",
      "type": "image/png",
      "sizes": "32x32"
    },
    {
      "src": "/icons/favicon-16x16.png",
      "type": "image/png",
      "sizes": "16x16"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/home.webp",
      "sizes": "540x960",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Find the government schemes you qualify for"
    },
    {
      "src": "/screenshots/eligibility.webp",
      "sizes": "540x960",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Check your eligibility in a minute"
    },
    {
      "src": "/screenshots/assistant.webp",
      "sizes": "540x960",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Ask the AI assistant in Hindi or English"
    },
    {
      "src": "/screenshots/wide.webp",
      "sizes": "1280x800",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Home, eligibility check and AI assistant"
    }
  ],
  "categories": [
    "utilities",
    "education",
    "productivity",
    "lifestyle"
  ],
  "shortcuts": [
    {
      "name": "Find schemes",
      "short_name": "Search",
      "description": "Search schemes and app features",
      "url": "/?go=search",
      "icons": [
        {
          "src": "/icons/logo192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Check my eligibility",
      "short_name": "Eligibility",
      "description": "See the schemes you qualify for",
      "url": "/?go=checker",
      "icons": [
        {
          "src": "/icons/logo192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Money not received?",
      "short_name": "Money check",
      "description": "Find out why a scheme payment didn't arrive",
      "url": "/?go=money",
      "icons": [
        {
          "src": "/icons/logo192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Ask AI assistant",
      "short_name": "Ask AI",
      "description": "Ask about any scheme in Hindi or English",
      "url": "/?go=ai",
      "icons": [
        {
          "src": "/icons/logo192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  }
}
