{
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/(.*)",  "destination": "/index.html" }
  ],
  "crons": [
    {
      "path":     "/api/refresh-news",
      "schedule": "0 4 */3 * *"
    },
    {
      "path":     "/api/send-deadline-alerts",
      "schedule": "0 5 * * *"
    }
  ]
}
